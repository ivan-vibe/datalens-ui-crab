# Copy to .env and fill in the values for YOUR stack.
# .env is git-ignored; never commit real tokens or private keys.
#
# The defaults below match the fork deployment next to the official UI:
# UI on :8094, Rust monolith on host :8099, auth on host :8097.

TZ=Etc/UTC
APP_MODE=full
APP_ENV=production
APP_INSTALLATION=opensource
APP_VERSION=0.3831.0
RELEASE_VERSION=2.9.0
APP_PORT=3030
NODE_ENV=production
WORKERS=1
EXPORT_WORKBOOK_ENABLED=true
APP_BUILDER_CDN=false
UI_CORE_CDN=false
YANDEX_MAP_ENABLED=0
YANDEX_MAP_TOKEN=
HC=0
HC_ENDPOINT=
HC_PROTOCOL=
HC_MODULES=
TMPDIR=/tmp

# Backends. Everything is reached through the Docker host.
US_ENDPOINT=http://host.docker.internal:8099
BI_DATA_ENDPOINT=http://host.docker.internal:8099
BI_API_ENDPOINT=http://host.docker.internal:8099
META_MANAGER_ENDPOINT=http://host.docker.internal:8099
AUTH_ENDPOINT=http://host.docker.internal:8097

# Authentication. REQUIRED when AUTH_ENABLED=true.
# Keep multiline PEM keys on one line, using literal \n escapes.
AUTH_ENABLED=true
AUTH_POLICY=required
AUTH_SIGNUP_DISABLED=true
AUTH_MASTER_TOKEN=replace-me
AUTH_TOKEN_PUBLIC_KEY=replace-me
US_DYNAMIC_MASTER_TOKEN_PRIVATE_KEY=replace-me

# Theme store. The bind mount ./theme-data is used by docker-compose.yml.
THEMES_DATA_DIR=/opt/app/theme-data
THEMES_DATA_PATH=/opt/app/theme-data/themes.json
